# ==============================================================================
# Lucent — Academic Workspace Environment Configuration
# ==============================================================================
# NOTE: Server-side API keys must NEVER be prefixed with NEXT_PUBLIC_
# to prevent exposing them to the client browser.

# AI Service Configuration (Server-Side Only)
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default AI Model (defaults to gemini-1.5-flash)
AI_MODEL=gemini-1.5-flash

# Optional: Alternative OpenAI API key if using OpenAI instead of Gemini
# OPENAI_API_KEY=your_openai_api_key_here

# Local Storage Directory (Server-Side Only)
# Directory where uploaded documents and the JSON database are stored
DATA_DIR=.lucent

# Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
